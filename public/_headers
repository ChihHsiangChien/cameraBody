/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; img-src 'self' data: blob:; connect-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
# Vite content-hashes every file under /assets, so a changed file always has a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/anatomy/*
  Cache-Control: public, max-age=3600, must-revalidate
/anatomy/*.bin
  Content-Type: application/x-protobuf
# Preserve third-party license documents byte-for-byte on custom domains.
/licenses/*
  Cache-Control: public, max-age=3600, must-revalidate, no-transform
/version.json
  Cache-Control: no-store
