{
  "name": "human-anatomy-3d",
  "version": "3.5.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/prepare-assets.mjs && vite build && node scripts/check-size.mjs",
    "preview": "vite preview --host",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "node scripts/check-source.mjs",
    "check": "npm run lint && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
